{
    "name": "horde/notification",
    "description": "Notification library implementing subject-observer pattern",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Notification",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "messages",
        "toast"
    ],
    "time": "2026-04-08",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0",
        "ext-gettext": "*"
    },
    "require-dev": {},
    "suggest": {
        "horde/alarm": "^3 || dev-FRAMEWORK_6_0",
        "horde/nls": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Notification": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Notification\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}